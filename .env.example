# Node sağlayıcı WebSocket URL'i (Alchemy, QuickNode, Infura veya lokal node)
# Boş bırakılırsa uygulama SIMÜLASYON modunda çalışır (gerçek node gerekmez).
WSS_URL=

# Pipeline backend: memory | redis | kafka
BUS_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=dex.signals

# Eşikler
WHALE_USD_THRESHOLD=100000
NEW_WALLET_MAX_AGE_DAYS=7
# Bloğun baz ücretine göre kaç kat gas teklifi MEV şüphesi sayılır
MEV_GAS_MULTIPLIER=2.0
